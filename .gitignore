# ============================================================
# 凭证与登录态（严禁入库）
# ============================================================
.env
.env.local
*.env
!/.env.example

# 从项目资产库同步下来的凭证缓存（见 scripts/sync_env.py）
.env.asset
.env.asset.*

# 浏览器登录态：含各平台 session cookie，泄露即账号被接管
.browser_profile/
.douyin_profile/
.xq_profile/
.tgb_profile/
*.profile/

# ============================================================
# 运行产物与缓存
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

logs/*.tmp
tmp/
*.log

# ============================================================
# 调试素材：验证码/滑块/登录现场截图，无交付价值
# ============================================================
assets/

# ============================================================
# 临时排查脚本（项目约定：用完必须删，勿留在仓库）
# 保留在本地供排查参考，不进版本库
# ============================================================
source/probe_*.py
source/verify_*.py
source/diag_*.py
source/check_*.py
source/screenshot.py
source/cleanup_*.py
publish/douyin/_probe_*.py

# ============================================================
# 编辑器与系统
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# ============================================================
# 本地工作区数据
# ============================================================
.workbuddy/projects/
.workbuddy/artifacts/
